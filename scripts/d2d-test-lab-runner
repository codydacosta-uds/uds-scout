#!/usr/bin/env bash
set -u
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
export KUBECONFIG="$HOME/.config/d2d-test-lab/kubeconfig"

ROOT="$HOME/.d2d-test-lab"
WORKSPACE="$ROOT/workspace"
STATE_FILE="$ROOT/state"
STDOUT_LOG="$ROOT/stdout.log"
STDERR_LOG="$ROOT/stderr.log"
BASELINE_PODS="$ROOT/baseline-pods.json"
RUNNER="$HOME/.local/bin/d2d-test-lab-runner"
mkdir -p "$ROOT"

read_value() {
  local name="$1"
  if [ -f "$ROOT/$name" ]; then cat "$ROOT/$name"; else printf '%s' '-'; fi
}

write_value() {
  printf '%s' "$2" > "$ROOT/$1"
}

set_state() {
  write_value state "$1"
  write_value updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

set_phase() {
  write_value phase "$1"
  write_value updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

watch_for_test_phase() {
  while [ "$(read_value state)" = "deploying" ]; do
    if grep -Fq 'Completed "Deploy the UDS bundle' "$STDOUT_LOG" "$STDERR_LOG" 2>/dev/null; then
      set_phase testing
      return
    fi
    sleep 1
  done
}

capture_pod_baseline() {
  local temporary="$BASELINE_PODS.tmp"
  if kubectl get pods -A -o json --request-timeout=10s > "$temporary"; then
    mv "$temporary" "$BASELINE_PODS"
    return 0
  fi
  rm -f "$temporary"
  return 1
}

find_bundle_artifact() {
  local bundle_name bundle_version artifact
  bundle_name=$(read_value bundle_name)
  bundle_version=$(read_value bundle_version)
  artifact=$(find "$WORKSPACE/bundle" -maxdepth 1 -type f -name "uds-bundle-${bundle_name}-*-${bundle_version}.tar.zst" -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
  if [ -n "$artifact" ]; then write_value bundle_artifact "$artifact"; fi
}

run_deploy() {
  local flavor flavor_note=""
  local -a flavor_options=()
  cd "$WORKSPACE" || { echo "The prepared workspace is unavailable." >&2; set_state failed; exit 1; }
  flavor=$(read_value flavor)
  if [ "$flavor" != "-" ]; then
    flavor_options=(--set "flavor=$flavor")
    flavor_note=" with the $flavor flavor"
  fi
  set_state deploying
  set +e
  if [ "$(read_value workflow)" = "deploy-only" ]; then
    set_phase building-and-deploying
    echo "Build and deploy the development bundle (uds run dev${flavor_note}). Repository tests will not run."
    ./uds run dev "${flavor_options[@]}"
    code=$?
  else
    set_phase building
    echo "Step 1 of 2: Build the development package (uds run create-dev-package${flavor_note})."
    ./uds run create-dev-package "${flavor_options[@]}"
    code=$?
    if [ "$code" -ne 0 ]; then
      echo "The development package build failed." >&2
      set_phase failed
      set_state failed
      exit "$code"
    fi
    set_phase deploying
    echo "Step 2 of 2: Create and deploy the bundle, prepare the test user, and run repository tests (uds run create-deploy-test-bundle${flavor_note})."
    watch_for_test_phase &
    phase_watcher=$!
    ./uds run create-deploy-test-bundle "${flavor_options[@]}"
    code=$?
    kill "$phase_watcher" 2>/dev/null || true
    wait "$phase_watcher" 2>/dev/null || true
  fi
  find_bundle_artifact
  if [ "$code" -eq 0 ]; then
    if [ "$(read_value bundle_artifact)" = "-" ]; then
      echo "Deployment completed but the generated bundle artifact was not found." >&2
      set_phase failed
      set_state failed
      exit 1
    fi
    set_phase deployed
    set_state deployed
  else
    set_phase failed
    set_state failed
  fi
  exit "$code"
}

run_cleanup() {
  local artifact
  artifact=$(read_value bundle_artifact)
  cd "$WORKSPACE" || { echo "The deployment workspace is unavailable." >&2; set_state failed; exit 1; }
  if [ "$artifact" = "-" ] || [ ! -f "$artifact" ]; then
    echo "The generated bundle artifact is unavailable; cleanup cannot run safely." >&2
    set_state failed
    exit 1
  fi
  set_phase cleaning
  set_state cleaning
  set +e
  ./uds remove "$artifact" --confirm --no-progress
  code=$?
  if [ "$code" -eq 0 ]; then set_phase complete; set_state complete; else set_phase failed; set_state failed; fi
  exit "$code"
}

if [ "${D2D_INTERNAL_ACTION:-}" = "deploy" ]; then run_deploy; fi
if [ "${D2D_INTERNAL_ACTION:-}" = "cleanup" ]; then run_cleanup; fi

read -r action repository branch sha bundle_name bundle_version workflow_mode flavor _extra <<< "${SSH_ORIGINAL_COMMAND:-}"

case "$action" in
  runner-capabilities)
    if [ -n "${repository:-}" ]; then echo "Runner capabilities does not accept arguments." >&2; exit 126; fi
    echo "flavor-selection-v1"
    ;;

  host-status)
    if [ -n "${repository:-}" ]; then echo "Host status does not accept arguments." >&2; exit 126; fi
    python3 - <<'PY'
import datetime
import json
import os
import shutil
import socket
import subprocess
import time


def cpu_sample():
    with open("/proc/stat", encoding="utf-8") as stat_file:
        values = [int(value) for value in stat_file.readline().split()[1:]]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return sum(values), idle


def memory_values():
    values = {}
    with open("/proc/meminfo", encoding="utf-8") as memory_file:
        for line in memory_file:
            name, value = line.split(":", 1)
            values[name] = int(value.strip().split()[0]) * 1024
    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable", values.get("MemFree", 0))
    return total, max(0, total - available), available


first_total, first_idle = cpu_sample()
time.sleep(0.4)
second_total, second_idle = cpu_sample()
total_delta = max(1, second_total - first_total)
idle_delta = max(0, second_idle - first_idle)
cpu_usage = max(0.0, min(100.0, (1 - idle_delta / total_delta) * 100))

memory_total, memory_used, memory_available = memory_values()
filesystems = []
seen_devices = set()
for path, label in (("/", "Root disk"), (os.path.expanduser("~"), "Home disk")):
    device = os.stat(path).st_dev
    if device in seen_devices:
        continue
    seen_devices.add(device)
    usage = shutil.disk_usage(path)
    filesystems.append({
        "label": label,
        "path": path,
        "totalBytes": usage.total,
        "usedBytes": usage.used,
        "availableBytes": usage.free,
        "usagePercent": round((usage.used / usage.total * 100) if usage.total else 0, 1),
    })

temporary_used_bytes = None
try:
    temporary_usage = subprocess.run(
        ["du", "-s", "-x", "--block-size=1", "--", "/tmp"],
        capture_output=True,
        text=True,
        timeout=5,
        check=False,
    )
    if temporary_usage.stdout.strip():
        temporary_used_bytes = int(temporary_usage.stdout.split()[0])
except (OSError, subprocess.TimeoutExpired, ValueError):
    pass

with open("/proc/uptime", encoding="utf-8") as uptime_file:
    uptime_seconds = float(uptime_file.read().split()[0])

print(json.dumps({
    "hostname": socket.gethostname(),
    "capturedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "cpuCount": os.cpu_count() or 1,
    "cpuUsagePercent": round(cpu_usage, 1),
    "loadAverage": [round(value, 2) for value in os.getloadavg()],
    "memory": {
        "totalBytes": memory_total,
        "usedBytes": memory_used,
        "availableBytes": memory_available,
        "usagePercent": round((memory_used / memory_total * 100) if memory_total else 0, 1),
    },
    "filesystems": filesystems,
    "temporaryStorage": {
        "path": "/tmp",
        "usedBytes": temporary_used_bytes,
    },
    "uptimeSeconds": round(uptime_seconds),
}, separators=(",", ":")))
PY
    ;;

  prepare)
    case "$repository" in
      uds-packages/artifactory|uds-packages/jira|uds-packages/xray|uds-packages/confluence|uds-packages/jenkins) ;;
      *) echo "Repository is not allowed in Test Lab." >&2; exit 126 ;;
    esac
    if ! git check-ref-format --branch "$branch" >/dev/null 2>&1; then echo "Branch name is invalid." >&2; exit 126; fi
    if [[ ! "$sha" =~ ^[0-9a-f]{40}$ ]]; then echo "Commit identifier is invalid." >&2; exit 126; fi
    if [[ ! "$bundle_name" =~ ^[a-zA-Z0-9._-]+$ ]] || [[ ! "$bundle_version" =~ ^[a-zA-Z0-9._-]+$ ]]; then echo "Bundle metadata is invalid." >&2; exit 126; fi
    if [ "$workflow_mode" != "deploy-only" ] && [ "$workflow_mode" != "build-deploy-test" ]; then echo "Workflow mode is not allowed." >&2; exit 126; fi
    if [ -n "${_extra:-}" ]; then echo "Prepare received unexpected arguments." >&2; exit 126; fi
    if [ "$flavor" != "-" ] && [[ ! "$flavor" =~ ^[a-zA-Z0-9._-]+$ ]]; then echo "Package flavor is invalid." >&2; exit 126; fi

    current_state=$(read_value state)
    if [ "$current_state" = "deploying" ] || [ "$current_state" = "cleaning" ] || [ "$current_state" = "deployed" ]; then
      echo "The active Test Lab deployment must be cleaned up before another run." >&2
      exit 2
    fi
    if [ "$current_state" = "failed" ] && [ "$(read_value bundle_artifact)" != "-" ]; then
      echo "The failed deployment produced a bundle artifact. Run cleanup before another test." >&2
      exit 2
    fi

    rm -rf "$WORKSPACE"
    : > "$STDOUT_LOG"
    : > "$STDERR_LOG"
    rm -f "$ROOT/bundle_artifact" "$BASELINE_PODS"
    git clone --filter=blob:none --no-checkout "git@github.com:${repository}.git" "$WORKSPACE"
    git -C "$WORKSPACE" fetch --depth=1 origin "$branch"
    actual_sha=$(git -C "$WORKSPACE" rev-parse FETCH_HEAD)
    if [ "$actual_sha" != "$sha" ]; then
      echo "The selected branch changed while the workspace was being prepared. Refresh and try again." >&2
      rm -rf "$WORKSPACE"
      exit 3
    fi
    git -C "$WORKSPACE" checkout --detach "$sha"

    if [ ! -f "$WORKSPACE/tasks.yaml" ] || [ ! -f "$WORKSPACE/bundle/uds-bundle.yaml" ] || [ ! -f "$WORKSPACE/zarf.yaml" ]; then
      echo "The selected branch is missing tasks.yaml, zarf.yaml, or bundle/uds-bundle.yaml." >&2
      exit 3
    fi
    remote_flavors=$(zarf tools yq '.components[] | select(.only.flavor != null) | .only.flavor' "$WORKSPACE/zarf.yaml" | sort -u)
    if [ -n "$remote_flavors" ]; then
      if [ "$flavor" = "-" ] || ! printf '%s\n' "$remote_flavors" | grep -Fxq -- "$flavor"; then
        echo "The selected flavor is not declared by this branch's zarf.yaml." >&2
        exit 3
      fi
    elif [ "$flavor" != "-" ]; then
      echo "This branch does not declare package flavors." >&2
      exit 3
    fi
    dev_task=$(zarf tools yq '.tasks[] | select(.name == "dev")' "$WORKSPACE/tasks.yaml")
    if [ -z "$dev_task" ] || printf '%s' "$dev_task" | grep -Eiq 'k3d|setup:k3d'; then echo "The dev task is missing or references forbidden cluster setup." >&2; exit 126; fi
    if [ -n "$(zarf tools yq '.tasks[] | select(.name == "dev") | .actions[] | select(has("cmd")) | .cmd' "$WORKSPACE/tasks.yaml")" ]; then echo "The dev task contains a direct command." >&2; exit 126; fi
    dev_actions=$(zarf tools yq '.tasks[] | select(.name == "dev") | .actions[] | .task' "$WORKSPACE/tasks.yaml")
    while IFS= read -r task; do
      [ -z "$task" ] && continue
      case "$task" in create-dev-package|dependencies:create|create:test-bundle|deploy:test-bundle) ;; *) echo "The dev task references unapproved action: $task" >&2; exit 126 ;; esac
    done <<< "$dev_actions"

    create_task=$(zarf tools yq '.tasks[] | select(.name == "create-dev-package")' "$WORKSPACE/tasks.yaml")
    if [ -z "$create_task" ] || printf '%s' "$create_task" | grep -Eiq 'k3d|setup:k3d'; then echo "create-dev-package is missing or unsafe." >&2; exit 126; fi
    if [ -n "$(zarf tools yq '.tasks[] | select(.name == "create-dev-package") | .actions[] | select(has("cmd")) | .cmd' "$WORKSPACE/tasks.yaml")" ]; then echo "create-dev-package contains a direct command." >&2; exit 126; fi
    create_actions=$(zarf tools yq '.tasks[] | select(.name == "create-dev-package") | .actions[] | .task' "$WORKSPACE/tasks.yaml")
    while IFS= read -r task; do [ -z "$task" ] && continue; if [ "$task" != "create:package" ]; then echo "create-dev-package references unapproved action: $task" >&2; exit 126; fi; done <<< "$create_actions"

    deploy_test_task=$(zarf tools yq '.tasks[] | select(.name == "create-deploy-test-bundle")' "$WORKSPACE/tasks.yaml")
    if [ -z "$deploy_test_task" ]; then echo "The selected branch does not define create-deploy-test-bundle." >&2; exit 3; fi
    if printf '%s' "$deploy_test_task" | grep -Eiq 'k3d|setup:k3d'; then echo "create-deploy-test-bundle references forbidden cluster setup." >&2; exit 126; fi
    if [ -n "$(zarf tools yq '.tasks[] | select(.name == "create-deploy-test-bundle") | .actions[] | select(has("cmd")) | .cmd' "$WORKSPACE/tasks.yaml")" ]; then echo "create-deploy-test-bundle contains a direct command." >&2; exit 126; fi
    deploy_test_actions=$(zarf tools yq '.tasks[] | select(.name == "create-deploy-test-bundle") | .actions[] | .task' "$WORKSPACE/tasks.yaml")
    while IFS= read -r task; do
      [ -z "$task" ] && continue
      case "$task" in dependencies:create|create:package|create:test-bundle|deploy:test-bundle|setup:create-doug-user|test:all) ;; *) echo "create-deploy-test-bundle references unapproved action: $task" >&2; exit 126 ;; esac
    done <<< "$deploy_test_actions"
    previous_line=0
    for required_task in create:test-bundle deploy:test-bundle setup:create-doug-user test:all; do
      action_line=$(printf '%s\n' "$deploy_test_actions" | grep -nxF "$required_task" | head -1 | cut -d: -f1)
      if [ -z "$action_line" ] || [ "$action_line" -le "$previous_line" ]; then echo "create-deploy-test-bundle is missing required actions or runs them out of order." >&2; exit 126; fi
      previous_line=$action_line
    done

    test_include=$(zarf tools yq '.includes[] | select(has("test")) | .test' "$WORKSPACE/tasks.yaml")
    if [ "$test_include" != "./tasks/test.yaml" ] || [ ! -f "$WORKSPACE/tasks/test.yaml" ]; then echo "The repository test include must resolve to ./tasks/test.yaml." >&2; exit 126; fi
    test_all=$(zarf tools yq '.tasks[] | select(.name == "all")' "$WORKSPACE/tasks/test.yaml")
    if [ -z "$test_all" ]; then echo "tasks/test.yaml does not define test:all." >&2; exit 126; fi
    test_actions=$(zarf tools yq '.tasks[] | select(.name == "all") | .actions[] | .task' "$WORKSPACE/tasks/test.yaml")
    if [ -z "$test_actions" ]; then echo "test:all does not reference any repository tests." >&2; exit 126; fi
    while IFS= read -r task; do
      [ -z "$task" ] && continue
      local_task=${task#test:}
      if [[ ! "$local_task" =~ ^[a-zA-Z0-9._-]+$ ]]; then echo "test:all contains an invalid test task name." >&2; exit 126; fi
      if [ -z "$(zarf tools yq ".tasks[] | select(.name == \"$local_task\")" "$WORKSPACE/tasks/test.yaml")" ]; then echo "test:all references missing test task: $task" >&2; exit 126; fi
    done <<< "$test_actions"
    all_test_references=$(zarf tools yq '.tasks[].actions[] | select(has("task")) | .task' "$WORKSPACE/tasks/test.yaml")
    if printf '%s\n' "$all_test_references" | grep -Eiq 'k3d|setup:k3d'; then echo "The repository test suite references forbidden cluster setup." >&2; exit 126; fi
    test_commands=$(zarf tools yq '.tasks[].actions[] | select(has("cmd")) | .cmd' "$WORKSPACE/tasks/test.yaml")
    if printf '%s' "$test_commands" | grep -Eiq '(^|[^a-z])k3d([^a-z]|$)|setup:k3d'; then echo "The repository test commands reference forbidden cluster setup." >&2; exit 126; fi

    remote_bundle_name=$(zarf tools yq '.metadata.name' "$WORKSPACE/bundle/uds-bundle.yaml")
    remote_bundle_version=$(zarf tools yq '.metadata.version' "$WORKSPACE/bundle/uds-bundle.yaml")
    if [ "$remote_bundle_name" != "$bundle_name" ] || [ "$remote_bundle_version" != "$bundle_version" ]; then echo "Bundle metadata does not match the validated branch." >&2; exit 3; fi

    ln -sf "$HOME/.local/bin/uds" "$WORKSPACE/uds"
    ln -sf "$HOME/.local/bin/zarf" "$WORKSPACE/zarf"
    write_value repository "$repository"
    write_value branch "$branch"
    write_value sha "$sha"
    write_value bundle_name "$bundle_name"
    write_value bundle_version "$bundle_version"
    write_value flavor "$flavor"
    write_value workflow "$workflow_mode"
    write_value started_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    set_phase prepared
    set_state prepared
    if [ "$workflow_mode" = "deploy-only" ]; then
      echo "Prepared $repository@$branch at $sha to build and deploy without repository tests."
    else
      echo "Prepared $repository@$branch at $sha to build the package, deploy the bundle, and run repository tests."
    fi
    ;;

  deploy-start)
    if [ "$(read_value state)" != "prepared" ]; then echo "Prepare a Test Lab session before deployment." >&2; exit 2; fi
    if ! kubectl --request-timeout=5s get --raw=/readyz >/dev/null 2>&1; then echo "The existing Kubernetes cluster is not reachable. Test Lab will not create a cluster." >&2; exit 4; fi
    if ! capture_pod_baseline; then echo "The current pod inventory could not be captured. Deployment was not started." >&2; exit 4; fi
    set_phase starting
    set_state deploying
    nohup env D2D_INTERNAL_ACTION=deploy "$RUNNER" </dev/null >"$STDOUT_LOG" 2>"$STDERR_LOG" &
    echo "Deployment started."
    ;;

  cleanup-start)
    state=$(read_value state)
    if [ "$state" != "deployed" ] && [ "$state" != "failed" ]; then echo "There is no deployed or failed bundle available for cleanup." >&2; exit 2; fi
    if [ "$(read_value bundle_artifact)" = "-" ]; then echo "No generated bundle artifact is available for cleanup." >&2; exit 2; fi
    set_phase cleaning
    set_state cleaning
    nohup env D2D_INTERNAL_ACTION=cleanup "$RUNNER" </dev/null >>"$STDOUT_LOG" 2>>"$STDERR_LOG" &
    echo "Cleanup started."
    ;;

  session-reset)
    state=$(read_value state)
    if [ "$state" = "deploying" ] || [ "$state" = "cleaning" ] || [ "$state" = "deployed" ]; then echo "Active deployments cannot be cleared. Run cleanup first." >&2; exit 2; fi
    if [ "$state" = "failed" ] && [ "$(read_value bundle_artifact)" != "-" ]; then echo "A bundle artifact is available. Run cleanup before clearing the session." >&2; exit 2; fi
    rm -rf "$ROOT"
    mkdir -p "$ROOT"
    echo "Session cleared."
    ;;

  session-images)
    if [ ! -f "$WORKSPACE/bundle/uds-bundle.yaml" ]; then echo "No prepared Test Lab bundle is available." >&2; exit 2; fi
    package_names=$(zarf tools yq '.packages[].name' "$WORKSPACE/bundle/uds-bundle.yaml")
    if [ -z "$package_names" ]; then echo "The prepared bundle does not declare any packages." >&2; exit 3; fi
    export D2D_PACKAGE_NAMES="$package_names"
    export D2D_BASELINE_PODS="$BASELINE_PODS"
    python3 - <<'PY'
import datetime
import json
import os
import subprocess
import sys

packages = sorted({item.strip() for item in os.environ["D2D_PACKAGE_NAMES"].splitlines() if item.strip() and item.strip() != "null"})
baseline_path = os.environ["D2D_BASELINE_PODS"]
baseline_available = os.path.isfile(baseline_path)
baseline_uids = set()
if baseline_available:
    try:
        with open(baseline_path, encoding="utf-8") as baseline_file:
            baseline_uids = {item.get("metadata", {}).get("uid") for item in json.load(baseline_file).get("items", [])}
    except (OSError, ValueError):
        baseline_available = False

result = subprocess.run(["kubectl", "get", "pods", "-A", "-o", "json", "--request-timeout=10s"], capture_output=True, text=True)
if result.returncode:
    print(result.stderr.strip() or "Kubernetes pod inventory is unavailable.", file=sys.stderr)
    raise SystemExit(result.returncode)

pods = json.loads(result.stdout).get("items", [])
items = []
matched_pods = set()
for pod in pods:
    metadata = pod.get("metadata", {})
    labels = metadata.get("labels", {})
    package = labels.get("zarf.dev/package")
    if package not in packages:
        continue
    namespace = metadata.get("namespace", "default")
    pod_name = metadata.get("name", "unknown")
    matched_pods.add((namespace, pod_name))
    annotations = metadata.get("annotations", {})
    owner = next((item for item in metadata.get("ownerReferences", []) if item.get("controller")), None)
    status = pod.get("status", {})
    status_by_name = {item.get("name"): item for item in status.get("containerStatuses", []) + status.get("initContainerStatuses", [])}
    pod_uid = metadata.get("uid")
    session_change = "unknown" if not baseline_available else "existing" if pod_uid in baseline_uids else "session"
    for container_type, containers in (("init", pod.get("spec", {}).get("initContainers", [])), ("container", pod.get("spec", {}).get("containers", []))):
        for container in containers:
            name = container.get("name", "unknown")
            container_status = status_by_name.get(name, {})
            image_id = container_status.get("imageID", "")
            digest = image_id.rsplit("@", 1)[1] if "@" in image_id else None
            terminated = container_status.get("state", {}).get("terminated", {})
            ready = bool(container_status.get("ready")) or (container_type == "init" and terminated.get("exitCode") == 0)
            items.append({
                "package": package,
                "namespace": namespace,
                "pod": pod_name,
                "podPhase": status.get("phase", "Unknown"),
                "ownerKind": owner.get("kind") if owner else None,
                "ownerName": owner.get("name") if owner else None,
                "container": name,
                "containerType": container_type,
                "image": annotations.get(f"zarf.dev/original-image-{name}", container.get("image", "unknown")),
                "runtimeImage": container.get("image", "unknown"),
                "digest": digest,
                "ready": ready,
                "sessionChange": session_change,
            })

items.sort(key=lambda item: (item["package"], item["namespace"], item["pod"], item["containerType"], item["container"]))
print(json.dumps({
    "capturedAt": datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z"),
    "baselineAvailable": baseline_available,
    "packages": packages,
    "podCount": len(matched_pods),
    "items": items,
}, separators=(",", ":")))
PY
    ;;

  session-status)
    state=$(read_value state)
    printf 'STATE=%s\n' "$state"
    printf 'REPOSITORY=%s\n' "$(read_value repository)"
    printf 'BRANCH=%s\n' "$(read_value branch)"
    printf 'SHA=%s\n' "$(read_value sha)"
    printf 'BUNDLE_NAME=%s\n' "$(read_value bundle_name)"
    printf 'BUNDLE_VERSION=%s\n' "$(read_value bundle_version)"
    printf 'BUNDLE_ARTIFACT=%s\n' "$(read_value bundle_artifact)"
    printf 'FLAVOR=%s\n' "$(read_value flavor)"
    printf 'WORKFLOW=%s\n' "$(read_value workflow)"
    printf 'PHASE=%s\n' "$(read_value phase)"
    printf 'STARTED_AT=%s\n' "$(read_value started_at)"
    printf 'UPDATED_AT=%s\n' "$(read_value updated_at)"
    printf 'CONTEXT=%s\n' "$(kubectl config current-context 2>/dev/null || printf '-')"
    if kubectl --request-timeout=3s get --raw=/readyz >/dev/null 2>&1; then cluster=true; else cluster=false; fi
    printf 'CLUSTER_REACHABLE=%s\n' "$cluster"
    printf '%s\n' '---STDOUT---'
    tail -c 32000 "$STDOUT_LOG" 2>/dev/null || true
    printf '\n%s\n' '---STDERR---'
    tail -c 32000 "$STDERR_LOG" 2>/dev/null || true
    printf '\n%s\n' '---WORKLOADS---'
    if [ "$cluster" = true ]; then kubectl get deployments,statefulsets,pods -A -o wide --request-timeout=5s 2>&1 | tail -n 120; else echo "Cluster API is not reachable."; fi
    ;;

  *)
    echo 'This SSH key accepts only configured D2D Test Lab workflow actions.' >&2
    exit 126
    ;;
esac
