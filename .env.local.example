# Create .env.local or export this variable before starting the app.
# Never commit the real token.
GITHUB_TOKEN=github_pat_your_token_here

# Optional NVD API key. Application CVE lookups also work through the rate-limited public API.
# NVD_API_KEY=nvd_api_key_here

# Optional Gitlab API token for selected-project work items and explicitly confirmed ticket batches.
GITLAB_TOKEN=gitlab_token_your_token_here

# Optional Gitlab origin. Defaults to https://gitlab.sonic.mil.
GITLAB_URL=https://gitlab.sonic.mil

# Optional comma-separated override for the tracked repository list.
# This takes precedence over repositories chosen in Workspace settings.
GITHUB_REPOSITORIES=nswccd-devsecops/sonic-swf-iac,uds-packages/artifactory,uds-packages/jira,uds-packages/xray,uds-packages/confluence,uds-packages/jenkins

# Optional location for the non-secret local workspace settings file.
# UDS_SCOUT_SETTINGS_PATH=/path/to/settings.json

# Optional location for the non-secret security intelligence cache.
# Defaults to security-cache.json beside the settings file.
# UDS_SCOUT_SECURITY_PATH=/path/to/security-cache.json
